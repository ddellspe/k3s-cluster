apiVersion: v1
kind: Secret
metadata:
  name: buyoutyourcoach-api-secret
  namespace: buyoutyourcoach
  labels:
    app: buyoutyourcoach
type: Opaque
stringData:
  # Generate using: openssl rand -hex 24
  ADMIN_API_KEY: "replace-with-generated-api-key"
  # LiteLLM virtual key for Daily Pulse Agent
  LLM_API_KEY: "replace-with-litellm-virtual-key"
