use_default_settings: true
general:
  debug: false
  instance_name: "SearXNG"
search:
  safe_search: 0
  autocomplete: "duckduckgo"
  formats:
    - html
    - json
outgoing:
  request_timeout: 5.0
  max_request_timeout: 10.0
  verify: false
  useragent_suffix: "(https://your-domain.dev; admin@example.com)"
server:
  port: 8080
  bind_address: "0.0.0.0"
  limiter: false
  image_proxy: true
ui:
  static_use_hash: true
  theme_args:
    simple_style: auto
